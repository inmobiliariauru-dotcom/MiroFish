# ====================================================================
# PISO OS V3 — environment template
# Copy to .env and fill real values. .env is gitignored.
# Backend boots with missing vars → affected agent runs in MOCK mode
# (UI shows orange badge). It will not crash.
# ====================================================================

# ---- Server ----
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# ---- Database (Postgres 16) ----
# Local Postgres example:
#   postgres://piso_app:CHANGEME@localhost:5432/piso_os
# Add ?sslmode=require for managed/cloud DBs.
DATABASE_URL=

# ---- Tokko Broker / Salboo (READ-ONLY from our side) ----
# Tokko REST API. Salboo allowlists by IP, so this only works from
# whitelisted hosts (typically your office / Mac).
TOKKO_API_KEY=
TOKKO_BASE_URL=https://www.tokkobroker.com/api/v1

# Daily Excel inventory export path. Drop the .xlsx into this dir
# (default: data/inbox/) and agent 01 ingests it on its next run.
# Format: Meta Commerce Catalog (home_listing_id, availability,
# address.region, image[N].url, num_beds, num_baths, ...). Agent 01
# also accepts a "standard" header set (ID/Operación/Tipo/...) as
# fallback. After successful ingest the file is moved to
# SALBOO_PROCESSED_DIR (default: data/processed/<timestamp>/).
SALBOO_INBOX_DIR=data/inbox
SALBOO_PROCESSED_DIR=data/processed

# ---- Supermetrics (Ruta A: API enterprise) ----
SUPERMETRICS_API_KEY=
SUPERMETRICS_TEAM_KEY=
SUPERMETRICS_BASE_URL=https://api.supermetrics.com/enterprise/v2/query

# ---- Google Ads / GA4 (read-only via Supermetrics) ----
GA4_PROPERTY_ID=446039439
GOOGLE_ADS_CUSTOMER_ID=7523466283

# ---- Meta (READ-ONLY ALWAYS — never write campaigns/budgets) ----
# Documented active IDs (per CLAUDE.md):
#   META_AD_ACCOUNT_ID=act_1333695193647738
#   META_BUSINESS_ID=1524937811797912
META_AD_ACCOUNT_ID=
META_BUSINESS_ID=
META_ACCESS_TOKEN=
# Pixel ID that survives bug #1 cleanup (only one pixel allowed in HTML)
META_PIXEL_ID_PRIMARY=

# ---- GTM (frontend tag) ----
GTM_CONTAINER_ID=GTM-TN8SRRR8

# ---- Optional: force MOCK mode per integration (debug/dev only) ----
# MOCK_TOKKO=false
# MOCK_SUPERMETRICS=false
