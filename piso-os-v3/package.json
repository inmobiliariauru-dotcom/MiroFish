{
  "name": "piso-os-v3",
  "version": "0.3.0",
  "private": true,
  "description": "PISO OS V3 — operations dashboard + 14 agents for Piso Inmobiliario",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon --watch server --ext js,json server/index.js",
    "db:migrate": "node bin/migrate.js up",
    "db:migrate:down": "node bin/migrate.js down",
    "db:seed": "node bin/seed.js",
    "db:reset": "node bin/migrate.js reset && npm run db:migrate && npm run db:seed",
    "lint:check": "node -e \"require('fs').readdirSync('server', {recursive:true}).filter(f=>f.endsWith('.js')).forEach(f=>require('child_process').execSync('node --check server/'+f, {stdio:'inherit'}))\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.6.1",
    "nodemon": "^3.1.4"
  }
}
